generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pharmacy {
  id            Int      @id @default(autoincrement())

  name          String

  chain         String?

  address       String?

  phone         String?

  email         String?

  website       String?

  openingHours  String?

  rating        String?

  notes         String?

  image         String?

  latitude      Float

  longitude     Float

  createdAt     DateTime @default(now())
}

model Review {
  id         Int      @id @default(autoincrement())
  pharmacyId String
  rating     Int
  text       String
  createdAt  DateTime @default(now())
}