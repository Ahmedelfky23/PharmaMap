# PostgreSQL Connection String (e.g. Supabase, Neon, or Render PostgreSQL)
DATABASE_URL="postgresql://username:password@hostname:5432/database?sslmode=require"
DIRECT_URL="postgresql://username:password@hostname:5432/database?sslmode=require"

# Optional: Port number (defaults to 5000)
PORT=5000

# Optional: Admin secret key to protect the Overpass OSM mass importer endpoint
ADMIN_SECRET="your-secure-admin-secret-here"

